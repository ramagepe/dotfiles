#!/bin/bash

# Set the next boot to Windows Boot Manager (one-time only).
# Uses UEFI BootNext variable via efibootmgr, which only affects the
# immediate next boot and then reverts to the normal BootOrder.

set -euo pipefail

# Verify UEFI
if [[ ! -d /sys/firmware/efi ]]; then
  echo "Error: System is not booted in UEFI mode." >&2
  exit 1
fi

# Verify efibootmgr
if ! command -v efibootmgr &>/dev/null; then
  echo "Error: efibootmgr is not installed." >&2
  exit 1
fi

# Find the Windows Boot Manager entry number
WINDOWS_ENTRY=$(efibootmgr | grep -i "Windows Boot Manager" | head -1 | grep -oP 'Boot\K[0-9A-Fa-f]{4}')

if [[ -z "$WINDOWS_ENTRY" ]]; then
  echo "Error: No 'Windows Boot Manager' entry found in EFI boot entries." >&2
  echo "" >&2
  echo "Available entries:" >&2
  efibootmgr | grep "^Boot" >&2
  exit 1
fi

echo "Found Windows Boot Manager at entry: Boot${WINDOWS_ENTRY}"
echo ""

# Set BootNext
sudo efibootmgr --bootnext "$WINDOWS_ENTRY" > /dev/null

echo "Next boot set to Windows."
echo "After that boot, it will automatically revert to the normal boot order (Omarchy)."
echo ""
echo "Shut down whenever you're ready."
