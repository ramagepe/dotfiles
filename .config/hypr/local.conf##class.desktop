# ── Configuracion especifica del DESKTOP (AenimazZe) ──────────────────────────
#
# Este archivo lo materializa yadm como ~/.config/hypr/local.conf segun el valor
# de `yadm config local.class`. NO editar local.conf directamente: se pisa.
# Editar SIEMPRE este archivo (local.conf##class.desktop) y correr `yadm alt`.

# Brillo del monitor externo por DDC/CI.
# Esta maquina es un escritorio con un BenQ por DisplayPort: no tiene backlight
# interno, asi que el brillo se controla con la rueda de volumen + Ctrl.
bindeld = CTRL, XF86AudioRaiseVolume, Brightness up, exec, omarchy-brightness-ddc +5%
bindeld = CTRL, XF86AudioLowerVolume, Brightness down, exec, omarchy-brightness-ddc 5%-

# Receptor Logitech Unifying (teclado/mouse inalambricos)
exec-once = solaar &

# Apps que arrancan con la sesion
exec-once = xdg-terminal-exec
exec-once = zen-browser
exec-once = postman
exec-once = obsidian
exec-once = discord
exec-once = bitwarden-desktop
exec-once = nautilus
exec-once = spotify
