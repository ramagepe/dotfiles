# yadm gitignore — política de WHITELIST
#
# Este repo contiene SOLO configuración del sistema y del escritorio: lo que
# trasciende de una máquina a otra. NO es un backup del home.
#
# Explícitamente fuera de alcance:
#   - ~/code y todo espacio de trabajo (cada proyecto tiene su propio repo)
#   - credenciales de cualquier tipo (el remoto es PÚBLICO)
#   - estado de aplicaciones, cachés, binarios y datos
#
# Por eso se ignora todo por defecto y se habilita archivo por archivo. Para
# agregar algo nuevo hay que abrirle la puerta acá primero. El beneficio:
# `yadm status -uall` vuelve a ser una lista corta y legible de lo que falta.

/*
!/.gitignore
!/README.md
# Como migrar una maquina de Omarchy 3.x a 4 (quattro).
!/MIGRACION-OMARCHY-4.md
# Script de instalación en una máquina nueva. Vive en la raíz del repo para que
# la URL de raw sea corta y se pueda correr con un curl de una línea.
!/bootstrap.sh

# ============================== Shell ==============================
!/.bashrc
!/.aliases
!/.XCompose

# ============================== ~/.config ==========================
!/.config
/.config/*

# --- Escritorio: Hyprland y compañía ---
# Desde Omarchy 4 la config de Hyprland es Lua: hyprland.lua carga los defaults
# del paquete y despues estos modulos. Los .conf que quedan los leen otros
# procesos (hyprsunset, xdg-desktop-portal-hyprland), no Hyprland.
!/.config/hypr
# local.lua lo materializa yadm desde local.lua##class.<desktop|laptop>.
.config/hypr/local.lua
# monitors.lua es estado de cada maquina y lo reescribe Omarchy cuando se
# cambia la escala (SUPER + SLASH / omarchy-hyprland-monitor-scaling). El layout
# de pantallas que si es propio vive en local.lua##class.*, que se carga despues.
.config/hypr/monitors.lua
# Generado por Omarchy para el LSP de Lua.
.config/hypr/.luarc.json
# Verificados idénticos (o anteriores) al default de Omarchy: trackearlos
# congelaría defaults viejos y le impediría a Omarchy actualizarlos.
.config/hypr/hyprsunset.conf
.config/hypr/xdph.conf
!/.config/omarchy
.config/omarchy/current/
.config/omarchy/themes/
.config/omarchy/branding/screensaver-backup.txt
*.sample

# --- Terminales ---
!/.config/ghostty
!/.config/alacritty
!/.config/tmux
# xdg-terminals.list no se versiona: en Omarchy 4 lo genera
# `omarchy default terminal ghostty`, que bootstrap.sh ya corre.
.config/xdg-terminals.list

# --- Herramientas de línea de comandos ---
!/.config/git
.config/git/hosts.yml
!/.config/gh
.config/gh/hosts.yml
!/.config/mise
!/.config/htop
.config/htop/htop_history
!/.config/herdr
/.config/herdr/*
!/.config/herdr/config.toml

# --- Editores ---
!/.config/nvim
.config/nvim/lazy-lock.json
.config/nvim/.luarc.json
!/.config/zed
/.config/zed/*
!/.config/zed/settings.json
!/.config/Code
/.config/Code/*
!/.config/Code/User
/.config/Code/User/*
!/.config/Code/User/settings.json
!/.config/Code/User/keybindings.json

# --- Integración de escritorio ---
!/.config/mimeapps.list
!/.config/user-dirs.dirs
!/.config/gtk-3.0
/.config/gtk-3.0/*
!/.config/gtk-3.0/bookmarks

# --- Servicios de usuario ---
# Los *.wants son el estado que genera `systemctl --user enable`, no
# configuracion: las unidades se habilitan a mano en cada maquina.
!/.config/systemd
.config/systemd/user/*.wants/

# --- yadm: bootstrap, encrypt, alternates ---
!/.config/yadm

# ============================== Agentes ============================
!/.claude
/.claude/*
!/.claude/settings.json
!/.claude/CLAUDE.md
!/.claude/keybindings.json
!/.claude/skills

!/.agents
/.agents/*
!/.agents/skills

# ============================== ~/.local/bin =======================
# Sólo los scripts propios. El resto son 240 MB de binarios.
!/.local
/.local/*
!/.local/bin
/.local/bin/*
!/.local/bin/schedule-shutdown
!/.local/bin/schedule-shutdown-prompt
!/.local/bin/tmux-smooth-zoom
!/.local/bin/monitor-external-toggle
!/.local/bin/power-profile-low-battery

# ============================== Cortes transversales ===============
# Valen dentro de cualquier directorio habilitado arriba.

# Credenciales — el remoto es público
.secrets
.env
.env.*
*.pem
*.key
id_*
**/hosts.yml
**/auth.json
**/credentials
**/*token*.json

# Ruido
*.bak
*.bak.*
*.pacnew
*.log
node_modules/
__pycache__/
*.pyc
.DS_Store
